# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=...
TELEGRAM_OWNER_USER_ID=...
TELEGRAM_APPLICATION_USER_ID=1

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Suppoerted providers: "kimicode", "cliproxyapi"
# Uncomment ONE provider section below

# --- Kimi Code provider ---
# 1. Get API key from Kimi Code membership page (sk-kimi-... format)
# 2. Uncomment the lines below
LLM_PROVIDER=kimicode
LLM_MODEL=k3
LLM_API_BASE=https://api.kimi.com/coding/v1
KIMICODE_API_KEY=sk-kimi-...

# --- CLIProxyAPI provider ---
# 1. Install:      brew install cliproxyapi (macOS) or see README for Linux
# 2. Authenticate: cliproxyapi --codex-login
# 3. Start proxy:  cliproxyapi  (default port 8317)
# 4. Uncomment the lines below
# Must match CLIPROXYAPI_API_KEY in agent-apiproxy/agent-apiproxy.env.
# LLM_PROVIDER=cliproxyapi
# LLM_MODEL=gpt-5.6-sol
# LLM_API_BASE=http://localhost:8317/v1
# CLIPROXYAPI_API_KEY=cliproxyapi
# LLM_REASONING_EFFORT=xhigh

# Shared model settings
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=1
LLM_TOOL_ROUND_LIMIT=6

# Conversation compression
AGENT_TOKEN_THRESHOLD=200000
AGENT_TARGET_TOKENS=40000
COMPRESSION_STEP_INTERVAL=100
COMPRESSION_TURN_TRIGGER=100
COMPRESSION_TURN_TARGET=25
COMPRESSION_KEEP_RECENT_TURNS=3
COMPRESSION_SUMMARY_MAX_TOKENS=2000
COMPRESSION_SUMMARY_INPUT_TOKENS=50000
COMPRESSION_TOOL_PAYLOAD_MAX_TOKENS=200

# Tavily web search
TAVILY_API_KEY=tvly-...
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# User messages, bot replies, and tool details are redacted from logs by default.
LOG_PRIVATE_CONTENT=False
LOG_LEVEL=INFO
LOG_FILE=.logs/reminder-agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Application reliability settings
DEFAULT_TIMEZONE=Asia/Singapore
DATABASE_PATH=.db/reminder-agent.db
WORKER_LEASE_SECONDS=60
UPDATE_POLL_SECONDS=0.25
OUTBOX_POLL_SECONDS=0.25
UPDATE_MAX_ATTEMPTS=3
UPDATE_RETRY_BASE_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=15

# Scheduler settings
SCHEDULER_POLL_SECONDS=1
SCHEDULER_BATCH_SIZE=100
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_SECONDS=30
