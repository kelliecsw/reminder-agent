# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=...
TELEGRAM_OWNER_USER_ID=...
TELEGRAM_APPLICATION_USER_ID=1

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Supported providers: "kimicode", "cliproxyapi", "openrouter" (alias "router" also accepted)
# The model list is auto-detected from GET {base_url}/models at startup; a
# configured model missing from the live catalog fails startup and lists the
# available models.
# LLM_API_KEY is the API key of the ACTIVE provider; LLM_API_BASE optionally
# overrides that provider's default base URL.
# Uncomment ONE provider section below

# --- Kimi Code provider ---
# 1. Get API key from Kimi Code membership page (sk-kimi-... format)
# 2. Uncomment the lines below
LLM_PROVIDER=kimicode
LLM_MODEL=k3
LLM_API_KEY=sk-kimi-...

# --- CLIProxyAPI provider ---
# 1. Install:      brew install cliproxyapi (macOS) or see README for Linux
# 2. Authenticate: cliproxyapi --codex-login
# 3. Start proxy:  cliproxyapi  (default port 8317)
# 4. Uncomment the lines below
# LLM_API_KEY must match the proxy's configured API key; it defaults to the
# "cliproxyapi" placeholder the proxy ships with.
# LLM_PROVIDER=cliproxyapi
# LLM_MODEL=gpt-5.6-sol
# LLM_API_KEY=cliproxyapi
# LLM_REASONING_EFFORT=xhigh
# Inside Docker, reach the proxy by its container hostname:
# LLM_API_BASE=http://cli-proxy-api:8317/v1

# --- OpenRouter provider ---
# 1. Create an API key at https://openrouter.ai/keys (sk-or-... format)
# 2. Uncomment the lines below
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-4.6
# LLM_API_KEY=sk-or-...
# LLM_MODEL defaults to anthropic/claude-sonnet-4.6 when unset.

# Shared model settings
# LLM_MODEL falls back to the active provider's default (k3, gpt-5.6-sol, or
# anthropic/claude-sonnet-4.6) when unset.
# Optional: LLM_API_BASE overrides the active provider's default base URL.
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=1
LLM_TOOL_ROUND_LIMIT=6

# Conversation compression
AGENT_TOKEN_THRESHOLD=200000
AGENT_TARGET_TOKENS=40000
COMPRESSION_STEP_INTERVAL=100
COMPRESSION_TURN_TRIGGER=100
COMPRESSION_TURN_TARGET=25
COMPRESSION_KEEP_RECENT_TURNS=3
COMPRESSION_SUMMARY_MAX_TOKENS=2000
COMPRESSION_SUMMARY_INPUT_TOKENS=50000
COMPRESSION_TOOL_PAYLOAD_MAX_TOKENS=200

# Tavily web search
TAVILY_API_KEY=tvly-...
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# User messages, bot replies, and tool details are redacted from logs by default.
LOG_PRIVATE_CONTENT=False
LOG_LEVEL=INFO
LOG_FILE=.logs/reminder-agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Application reliability settings
DEFAULT_TIMEZONE=Asia/Singapore
DATABASE_PATH=.db/reminder-agent.db
WORKER_LEASE_SECONDS=60
UPDATE_POLL_SECONDS=0.25
OUTBOX_POLL_SECONDS=0.25
UPDATE_MAX_ATTEMPTS=3
UPDATE_RETRY_BASE_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=15

# Scheduler settings
SCHEDULER_POLL_SECONDS=1
SCHEDULER_BATCH_SIZE=100
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_SECONDS=30
